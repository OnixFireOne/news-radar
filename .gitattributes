# Normalize line endings for cross-platform development
* text=auto eol=lf

# Python
*.py text eol=lf

# Docker / Shell
Dockerfile text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Web
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binaries — don't touch
*.db binary
*.session binary
*.jpg binary
*.png binary
