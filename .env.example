# ============================================================
# TELEGRAM USERBOT (для сбора новостей)
# Получить на: https://my.telegram.org/apps
# ============================================================
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION_NAME=news_radar_session

# ============================================================
# TELEGRAM BOT (для вывода дайджестов)
# Создать через @BotFather
# ============================================================
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_ALLOWED_USERS=123456789   # твой Telegram user_id через @userinfobot

# ============================================================
# LLM PROVIDERS (ТЗ #4 И3, spec section 6.1).
# Several connections coexist; which one serves which task is decided by
# "llm_routes" in config/settings.json. The provider registry itself lives in
# settings.json too — this file holds only endpoints and secrets.
# Model names are NOT here: they belong to the provider in settings.json.
# ============================================================

# --- Cloud provider (currently the primary one) ---
# OpenAI-compatible proxy: <base>/v1/chat/completions
LLM_CLOUD_BASE_URL=https://your-proxy.example.com/v1
LLM_CLOUD_API_KEY=your_proxy_api_key   # real proxy key; masked in logs (llm_core.mask)

# --- Local provider (Oobabooga / llama.cpp on your own machine) ---
# No key needed. Leave as is if you have no local model — no route points here
# until you switch one in settings.json.
LLM_LOCAL_BASE_URL=http://host.docker.internal:5000/v1

# --- Backwards compatibility with the pre-И3 prod config ---
# One shared set for both modes. Kept as a fallback source for the "local"
# provider when LLM_LOCAL_BASE_URL is unset. New installs may leave them empty.
LLM_BASE_URL=http://host.docker.internal:5000/v1
LLM_API_KEY=not-needed
LLM_MODEL=your-model-name   # see Oobabooga UI, or /v1/models on the proxy

# ============================================================
# DATABASE
# ============================================================
DATABASE_PATH=/app/data/news.db

# ============================================================
# ANALYZER SETTINGS
# ============================================================
ANALYZE_INTERVAL_MINUTES=30    # как часто запускать анализ
DIGEST_INTERVAL_HOURS=3        # как часто слать дайджест
MIN_MESSAGE_LENGTH=30          # игнорировать короткие сообщения

# ============================================================
# API
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================
# WEB
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================
# OPENCLAW INTEGRATION (опционально)
# Если задан — все алерты и дайджесты идут к агенту (не напрямую в Telegram).
# Агент сам решает: перевод, форматирование, куда слать (Telegram/Discord/etc).
# Если не задан — news-radar шлёт напрямую в Telegram (fallback режим).
# ============================================================
OPENCLAW_WEBHOOK_URL=   # например: http://localhost:8080/api/webhook/news-radar
