# ============================================================
# TELEGRAM USERBOT (для сбора новостей)
# Получить на: https://my.telegram.org/apps
# ============================================================
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION_NAME=news_radar_session

# ============================================================
# TELEGRAM BOT (для вывода дайджестов)
# Создать через @BotFather
# ============================================================
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_ALLOWED_USERS=123456789   # твой Telegram user_id через @userinfobot

# ============================================================
# LLM PROVIDERS
# Empty = legacy mode. Example: aiprime.messages
# Comma-separated profile names; order = priority, failover comes later.
# Base URLs and task models live in config/providers.json.
# ============================================================
LLM_PROVIDERS=
# LLM_KEY_<PROVIDER>: profile name before the dot, upper-case.
# Where to get it: your proxy dashboard.
LLM_KEY_AIPRIME=your_proxy_api_key
# OpenRouter key for the openrouter.* profiles (model comparison against the proxy).
# Where to get it: https://openrouter.ai/keys
LLM_KEY_OPENROUTER=your_openrouter_api_key
# Direct OpenAI API key for the openai.* profiles (model comparison).
# Where to get it: https://platform.openai.com/api-keys
LLM_KEY_OPENAI=your_openai_api_key
# Optional alternative catalog path inside the container; invalid files fail startup.
# LLM_PROVIDERS_FILE=

# Legacy endpoint: used only when LLM_PROVIDERS is empty.
LLM_BASE_URL=http://host.docker.internal:5000/v1
LLM_API_KEY=not-needed
LLM_MODEL=your-model-name   # see Oobabooga UI, or /v1/models on the proxy

# ============================================================
# DATABASE
# ============================================================
DATABASE_PATH=/app/data/news.db

# ============================================================
# ANALYZER SETTINGS
# ============================================================
ANALYZE_INTERVAL_MINUTES=30    # как часто запускать анализ
DIGEST_INTERVAL_HOURS=3        # как часто слать дайджест
MIN_MESSAGE_LENGTH=30          # игнорировать короткие сообщения

# ============================================================
# API
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================
# WEB
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================
# OPENCLAW INTEGRATION (опционально)
# Если задан — все алерты и дайджесты идут к агенту (не напрямую в Telegram).
# Агент сам решает: перевод, форматирование, куда слать (Telegram/Discord/etc).
# Если не задан — news-radar шлёт напрямую в Telegram (fallback режим).
# ============================================================
OPENCLAW_WEBHOOK_URL=   # например: http://localhost:8080/api/webhook/news-radar
